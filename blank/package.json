{
  "name": "mantle-starter-blank",
  "version": "0.0.11-alpha.63",
  "private": true,
  "description": "Minimal Mantle site for Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "generate": "mantle generate && wrangler types .mantle/generated/env.d.ts --env-file .mantle/empty.env --strict-vars false",
    "check:generated": "mantle generate --check && wrangler types .mantle/generated/env.d.ts --env-file .mantle/empty.env --strict-vars false --check",
    "validate": "mantle validate",
    "validate:deploy": "mantle validate --phase deploy",
    "check:indexes": "mantle-harness indexes --manifests manifests --require-public --format text",
    "mantle:update": "mantle update",
    "introspect": "mantle introspect",
    "emit-openapi": "mantle emit-openapi --output openapi.json",
    "emit-types": "mantle emit-types --namespace MantleSite --output .mantle/generated/types.d.ts",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "pnpm validate && pnpm validate:deploy && pnpm check:generated && pnpm typecheck && pnpm check:indexes && pnpm check:worker",
    "deploy": "pnpm check && wrangler deploy"
  },
  "dependencies": {
    "@aotter/mantle": "0.0.11-alpha.63"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
