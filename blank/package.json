{
  "name": "mantle-starter-blank",
  "version": "0.1.0-alpha.7",
  "private": true,
  "description": "Minimal Mantle site for Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "prepare": "pnpm generate",
    "build": "pnpm check",
    "generate": "mantle generate",
    "check:generated": "mantle generate --check",
    "validate": "mantle validate",
    "validate:deploy": "mantle validate --phase deploy",
    "check:indexes": "mantle-harness indexes --manifests manifests --require-public --format text",
    "mantle:update": "mantle update",
    "skills": "mantle skills",
    "introspect": "mantle introspect",
    "emit-openapi": "mantle emit-openapi --output openapi.json",
    "emit-types": "mantle emit-types --namespace MantleSite --output .mantle/generated/types.d.ts",
    "dev": "pnpm generate && wrangler dev --ip localhost --port 8787 --inspector-port 0 --persist-to .wrangler",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "pnpm generate && pnpm validate && pnpm validate:deploy && pnpm check:generated && pnpm typecheck && pnpm check:indexes && pnpm check:worker",
    "deploy": "pnpm check && wrangler deploy"
  },
  "dependencies": {
    "@aotter/mantle": "0.1.0-alpha.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
