{
  "name": "mantle-starters",
  "private": true,
  "version": "0.0.11-alpha.67",
  "description": "Workspace root for blank-first Mantle bundles, type overlays, and replaceable vendored UI source.",
  "license": "MIT",
  "homepage": "https://mantle.tools/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aotter/mantle-starters.git"
  },
  "type": "module",
  "mantleCoreSha": "57c11992bb4a45bbe03ed48e44896f9385e855bc",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "corepack pnpm@9.15.0 -r --filter './packages/**' build",
    "build:provision-bundle": "node scripts/build-provision-bundle.mjs",
    "build:styles": "node recipes/typed-web/scripts/build-styles.mjs --root recipes/typed-web",
    "check:provision-bundle": "node scripts/build-provision-bundle.mjs --check",
    "check:styles": "node recipes/typed-web/scripts/build-styles.mjs --root recipes/typed-web --check",
    "dev:bundle": "node scripts/dev-provision-bundle.mjs",
    "materialize": "node scripts/dev-provision-bundle.mjs",
    "smoke:provision-bundle": "node scripts/smoke-provision-bundle.mjs",
    "smoke:blank": "node scripts/smoke-headless-blank.mjs",
    "check:kiwa": "node scripts/sync-kiwa.mjs --check",
    "check:starter-locks": "node scripts/refresh-starter-locks.mjs --check",
    "check:repo-local-skills": "node scripts/check-repo-local-skills.mjs",
    "check:release-worker": "node scripts/release-check-state.mjs --self-test",
    "check:core-skills": "pnpm --dir blank exec mantle skills --check",
    "check:exact": "pnpm check:provision-bundle && pnpm check:repo-local-skills && pnpm check:starter-locks",
    "check:packed": "pnpm check:release-worker && pnpm --dir blank check && pnpm smoke:blank && pnpm smoke:provision-bundle && pnpm check:repo-local-skills && pnpm check:core-skills && pnpm --dir recipes/typed-web typecheck",
    "refresh:starter-locks": "node scripts/refresh-starter-locks.mjs",
    "typecheck": "corepack pnpm@9.15.0 -r typecheck",
    "test": "corepack pnpm@9.15.0 -r test"
  },
  "devDependencies": {
    "tailwindcss": "catalog:",
    "yaml": "catalog:"
  },
  "packageManager": "pnpm@9.15.0"
}
